  "quotes": {
    "pr.decision": {
      "doc": "PR-1109",
      "quote": "’26.10.29. ㈜우아한형제들(서비스명 배달의민족, 이하 ‘배민’)과 쿠팡㈜(서비스명 쿠팡, 쿠팡이츠, 이하 ‘쿠팡’)이 시장지배적 지위를 남용한 최혜대우 요구 등으로 배달 시장의 경쟁을 저해한 행위 등에 대해 시정명령과 함께 배민에 대해 3,311억 원*(잠정), 쿠팡에 대해 3,008억 원(잠정)의 과징금을 부과하기로 결정하였다."
    },
    "pr.breakdown": {
      "doc": "PR-1109",
      "quote": "* (최혜대우 요구) 1,602억 원, (자체배달** 전환 강제) 1,554억 원, (배달예상시간 기만광고) 154억 원"
    },
    "pr.registered": {
      "doc": "PR-1109",
      "quote": "등록 : 2026-11-09"
    },
    "pr.mfnDef": {
      "doc": "PR-1109",
      "quote": "MFN(Most Favored Nation) 요구: 거래상대방에게 자신의 거래조건을 경쟁자와 같거나 경쟁자에 비해 유리하게 적용할 것을 요구하는 것을 말함"
    },
    "pr.cpng6": {
      "doc": "PR-1109",
      "quote": "메뉴가격을 포함한 6가지 주요 거래조건*에 대한 MFN 조건을 미충족한 입점업체는 와우매장 지위를 박탈하는 방식으로 MFN 요구를 관철하였다."
    },
    "pr.cpng6list": {
      "doc": "PR-1109",
      "quote": "* 메뉴가격, 최소주문금액, 할인 혜택, 고객 부담 배달비, 메뉴 수, 운영시간"
    },
    "pr.bm3": {
      "doc": "PR-1109",
      "quote": "최소주문금액 등 세 가지 주요 거래조건*에 대해 MFN 요구를 충족한 입점업체를 ‘배민클럽가게’로 선정하여"
    },
    "pr.feeUp": {
      "doc": "PR-1109",
      "quote": "’24.8.9.부터 자체배달 요금제 수수료율을 6.8%에서 9.8%로 인상하기로 하였다."
    },
    "pr.ratio": {
      "doc": "PR-1109",
      "quote": "MFN 요구를 충족한 와우매장 비율은 약 13%(’23.7.)에서 약 94%(’25.10.)로 급증하고 배민클럽가게 비율 또한 약 63%(’24.5.)에서 약 80%(’25.1.)로 크게 증가하였다."
    },
    "pr.exclude": {
      "doc": "PR-1109",
      "quote": "와우매장 또는 배민클럽가게에서 제외되는 입점업체는 현저한 매출 감소를 경험하게 된다. 그 결과, 대다수의 입점업체는 이들의 요구를 마지못해 수용하였고"
    },
    "pr.share": {
      "doc": "PR-1109",
      "quote": "배민, 쿠팡은 배달앱 시장의 1위(58.45%), 2위(34.44%) 사업자로서 시지사업자에 해당(’25, 주문금액 기준)"
    },
    "pr.judge": {
      "doc": "PR-1109",
      "quote": "공정위는 배민과 쿠팡의 각 행위가 시장지배적지위*를 남용하여 입점업체에게 정상적인 거래관행에 비추어 타당성이 없는 조건을 제시한 행위로서 입점업체 및 경쟁 사업자의 사업활동을 어렵게 하는 행위에 해당한다고 판단하였다."
    },
    "pr.also": {
      "doc": "PR-1109",
      "quote": "** 동시에 불공정거래행위 중 거래상지위 남용행위(경영활동 간섭)에도 해당된다고 판단"
    },
    "pr.entrant": {
      "doc": "CO-CPNG-1109",
      "quote": "배민과 쿠팡은 낮은 수수료율을 통해서 입점업체들이 상품 가격을 낮추도록 유도하여 시장에 진입·확장하려는 신규·중소 배달앱 사업자의 전략을 무력화함으로써 경쟁사의 사업활동도 방해하였다."
    },
    "pr.effect": {
      "doc": "PR-1109",
      "quote": "배달앱 시장에서 경쟁이 제한되어 수수료율*, 메뉴가격이 인상되고, 신규 진입 등이 봉쇄됨에 따라 소비자 후생이 감소하였다."
    },
    "pr.both90": {
      "doc": "PR-1109",
      "quote": "합산 점유율이 90%가 넘는 두 과점 사업자가 동시에 MFN 요구를 함으로써 높고 동일한 수준의 수수료 설정, 거래조건 동조화 등과 같이 담합이 이루어진 것과 유사한 강력한 경쟁제한효과를 초래하였다."
    },
    "pr.after": {
      "doc": "PR-1109",
      "quote": "MFN 요구가 금지됨에 따라 입점업체는 자신의 경영 판단에 따라 메뉴가격, 최소주문금액 등을 플랫폼별로 자율적으로 설정할 수 있게 되고"
    },
    "pr.reexam": {
      "doc": "PR-1109",
      "quote": "쿠팡(주)의 거래강제행위에 대한 건에 대하여 심의한 결과, 심사보고서상 주된 상품·종된 상품 개념에 대한 해석상 이견으로 인해 심의가 충실히 진행되지 못한 측면이 있고 이 사건의 중요성을 고려할 때 보다 내실 있는 심사를 한 후에 사건을 심의함이 적절하다고 판단하여 재심사 명령을 결정하였다."
    },
    "law.def": {
      "doc": "LAW-MRFTA",
      "quote": "“시장지배적사업자”란 일정한 거래분야의 공급자나 수요자로서 단독으로 또는 다른 사업자와 함께 상품이나 용역의 가격, 수량, 품질, 그 밖의 거래조건을 결정ㆍ유지 또는 변경할 수 있는 시장지위를 가진 사업자를 말한다."
    },
    "law.presume": {
      "doc": "LAW-MRFTA",
      "quote": "1. 하나의 사업자의 시장점유율이 100분의 50 이상\n2. 셋 이하의 사업자의 시장점유율의 합계가 100분의 75 이상. 이 경우 시장점유율이 100분의 10 미만인 사업자는 제외한다."
    },
    "law.ban": {
      "doc": "LAW-MRFTA",
      "quote": "3. 다른 사업자의 사업활동을 부당하게 방해하는 행위"
    },
    "law.fine6": {
      "doc": "LAW-MRFTA",
      "quote": "에 100분의 6을 곱한 금액을 초과하지 아니하는 범위에서 과징금을 부과할 수 있다."
    },
    "law.fine4": {
      "doc": "LAW-MRFTA",
      "quote": "제45조제1항(제9호는 제외한다), 제46조 또는 제48조를 위반하는 행위가 있을 때에는 해당 사업자에게 대통령령으로 정하는 매출액에 100분의 4를 곱한 금액을 초과하지 아니하는 범위에서 과징금을 부과할 수 있다."
    },
