{
  "name": "@claro/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLARO_PGLITE_DIR=${CLARO_PGLITE_DIR:-.data/dev} DATABASE_URL= next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc -p .",
    "test": "playwright test",
    "phone": "export CLARO_DIST=.next-phone CLARO_PGLITE_DIR=.data/phone CLARO_PEEK=1 DATABASE_URL= && tsx scripts/seed.ts && tsx scripts/reader.ts R-00 && next build && next start -p 3200 -H 0.0.0.0",
    "seed": "tsx scripts/seed.ts",
    "reader": "tsx scripts/reader.ts",
    "ledger": "node scripts/ledger.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "deploy:migrate": "tsx --env-file=.env.deploy scripts/migrate.ts",
    "deploy:seed": "tsx --env-file=.env.deploy scripts/seed.ts",
    "deploy:reader": "tsx --env-file=.env.deploy scripts/reader.ts",
    "deploy:verify": "tsx --env-file=.env.deploy scripts/verify-database.ts",
    "deploy:ledger": "tsx --env-file=.env.deploy scripts/ledger-db.ts"
  },
  "dependencies": {
    "@claro/contract": "workspace:*",
    "@claro/db": "workspace:*",
    "@claro/tokens": "workspace:*",
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.4",
    "motion": "13.5.1",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "4.23.15"
  }
}
