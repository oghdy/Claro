  "quotes": {
    "vy.lead": {
      "doc": "NASA-REL-26-098",
      "quote": "NASA’s Voyager 1 probe, humanity’s farthest-flying spacecraft, has reached one light-day from Earth, after more than 49 years of constant travel."
    },
    "vy.date": {
      "doc": "NASA-REL-26-098",
      "quote": "Nov 19, 2026"
    },
    "vy.lightday": {
      "doc": "NASA-REL-26-098",
      "quote": "A light-day is the distance light travels in 24 hours, equaling about 16.1 billion miles (25.9 billion kilometers)."
    },
    "vy.ladder": {
      "doc": "NASA-REL-26-098",
      "quote": "A ray of sunlight passing Earth takes about 1.3 seconds to reach the Moon, about four hours to reach Neptune, and another 20 hours to reach Voyager 1."
    },
    "vy.reach": {
      "doc": "NASA-REL-26-098",
      "quote": "On Nov. 18, 2026, Voyager 1 reached one light-day from Earth."
    },
    "vy.heard": {
      "doc": "NASA-REL-26-098",
      "quote": "Voyager team members at NASA’s Jet Propulsion Laboratory in Southern California, managed by Caltech, heard from the probe 24 hours later, the time it took for the spacecraft’s radio signal traveling at the speed of light to reach Earth, early Thursday."
    },
    "vy.break": {
      "doc": "NASA-REL-26-098",
      "quote": "Even though the team has not received science and engineering data from Voyager 1 since Nov. 14, the spacecraft is sending what is called a carrier signal, which typically conveys that data to Earth."
    },
    "vy.confirm": {
      "doc": "NASA-REL-26-098",
      "quote": "Mission engineers used the carrier signal and trajectory calculations to confirm the light-day milestone."
    },
    "vy.analyze": {
      "doc": "NASA-REL-26-098",
      "quote": "They continue to analyze the issue impacting the science and engineering data."
    },
    "vy.launch": {
      "doc": "NASA-REL-26-098",
      "quote": "Humanity’s only probes in interstellar space, Voyager 1 and its twin, Voyager 2, launched in 1977 to take advantage of a rare planetary alignment."
    },
    "vy.interstellar": {
      "doc": "NASA-REL-26-098",
      "quote": "In 2012, Voyager 1 became the first human-made spacecraft to enter interstellar space."
    },
    "vy.roundtrip": {
      "doc": "NASA-REL-26-098",
      "quote": "Even traveling at the speed of light, signals now take 24 hours to reach the spacecraft and 24 hours to reach us."
    },
    "vy.daily": {
      "doc": "NASA-REL-26-098",
      "quote": "We listen to Voyager 1 every day and send commands to the spacecraft weekly."
    },
    "vy.energy": {
      "doc": "NASA-REL-26-098",
      "quote": "The latest energy-saving effort is expected to provide enough power for both spacecraft to keep their current suite of science instruments operating until at least their 50th launch anniversaries next summer."
    },
    "vy.v2": {
      "doc": "NASA-REL-26-098",
      "quote": "Voyager 2, taking a different trajectory, crossed the boundary in 2018."
    },
    "vy.grand": {
      "doc": "NASA-REL-26-098",
      "quote": "Managed by JPL, they were only the third and fourth spacecraft to visit Jupiter and Saturn, and the first to return high-resolution imagery, transforming our understanding of these worlds and their moons."
    },
    "vy.v2study": {
      "doc": "NASA-REL-26-098",
      "quote": "Voyager 2 went on to study the ethereal ice giants, Neptune and Uranus."
    }
  },
